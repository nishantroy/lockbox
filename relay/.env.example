# Local Postgres started by `npm run db:start` (relay/docker-compose.yml).
# 127.0.0.1:56330 is reserved in /Users/nishantroy/code/AGENTS.md's local
# HTTP/service port registry for the phone-lockbox relay's Postgres.
DATABASE_URL=postgres://relay:relay@127.0.0.1:56330/companion_relay

# Bind address/port for `npm run dev` (relay/scripts/dev-server.ts).
# 127.0.0.1:8002 is reserved in the same port registry.
RELAY_HOST=127.0.0.1
RELAY_PORT=8002

# Retention window (days) after which terminal records are purged. Matches
# docs/r5-relay-plan.md's owner-approved 30-day retention decision.
RETENTION_DAYS=30

# Shared secret checked (in constant time) against the
# `Authorization: Bearer <CRON_SECRET>` header on the retention cron endpoint
# (api/cron/retention-purge.ts), the same convention Vercel Cron uses to
# authenticate its own invocations. `npm run retention:purge` does not go
# through this endpoint at all -- it calls the purge job directly against
# DATABASE_URL -- so this only matters once the cron endpoint is deployed.
CRON_SECRET=change-me-in-a-real-deployment

# When set to "true", POST /v1/inbox requires the signed query's optional
# `issuedAt` freshness field and rejects the legacy (issuedAt-less) form.
# Left unset locally until a client reliably sends it. See README's
# "Consent replay and inbox freshness".
# REQUIRE_FRESH_INBOX=true

# `pg` pool sizing (src/db.ts's getPool). Defaults (10 / 30000) suit local
# dev/tests. A serverless (Vercel) deployment should set these lower -- see
# README's "Vercel deployment shape" -- and point DATABASE_URL at Neon's
# *pooled* connection string.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
