# Local Postgres started by `npm run db:start` (relay/docker-compose.yml).
# 127.0.0.1:56330 is reserved in /Users/nishantroy/code/AGENTS.md's local
# HTTP/service port registry for the phone-lockbox relay's Postgres.
DATABASE_URL=postgres://relay:relay@127.0.0.1:56330/companion_relay

# Bind address/port for `npm run dev` (relay/scripts/dev-server.ts).
# 127.0.0.1:8002 is reserved in the same port registry.
RELAY_HOST=127.0.0.1
RELAY_PORT=8002

# Retention window (days) after which terminal records are purged. Matches
# docs/r5-relay-plan.md's owner-approved 30-day retention decision.
RETENTION_DAYS=30

# Shared secret checked against the `Authorization: Bearer <CRON_SECRET>`
# header on the retention cron endpoint (api/cron/retention-purge.ts), the
# same convention Vercel Cron uses to authenticate its own invocations. The
# local `npm run retention:purge` script also reads this to call the purge
# path directly, or you can run it with no server via --local (see README).
CRON_SECRET=change-me-in-a-real-deployment
